   "negatable": true,
   "patterns": {
    "en": [
     "\\b(?:share|send|provide|enter|submit|confirm|verify|update|give|tell|forward|reply\\s+with|type)\\b[^.!?\\n]{0,40}\\b(?:otp|one[\\s-]?time\\s+password|pin|mpin|upi\\s+pin|atm\\s+pin|password|passcode|cvv|cvc|card\\s+(?:number|details|no)|debit\\s+card|credit\\s+card|account\\s+(?:number|details|no)|bank\\s+details|net\\s?banking|login\\s+(?:details|credentials|id)|user\\s?(?:name|id)|credentials|aadhaar|aadhar|pan\\s+(?:number|card|details|no)|date\\s+of\\s+birth|dob|ssn|social\\s+security|security\\s+(?:code|answer)|verification\\s+code|expiry\\s+date)\\b",
     "\\b(?:otp|pin|cvv|password|verification\\s+code)\\b[^.!?\\n]{0,30}\\b(?:share|send|tell|provide|forward)\\b",
     "\\b(?:log\\s?in|sign\\s?in)\\s+(?:to|and)\\s+(?:verify|confirm|update|restore|unlock|secure)\\b",
