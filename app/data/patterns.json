{
 "_note": "Rule groups for suspicious language. Weights were set by hand (not learned). Patterns are regular expressions, matched without regard to upper/lower case. 'en' = English, 'hinglish' = Hindi in Latin letters, 'hi' = Hindi in Devanagari.",
 "negation": {
  "_note": "For groups marked negatable, a match is ignored when it is negated: 'Do NOT share your OTP'.",
  "before": "(?:\\b(?:do\\s+not|don'?t|dont|never|not|no\\s+one\\s+should|will\\s+never\\s+ask\\s+(?:you\\s+)?to|never\\s+ask\\s+(?:you\\s+)?to)\\s+(?:\\w+\\s+){0,2})$",
  "inside": "\\b(?:do\\s+not|don'?t|dont|never|not)\\b|\\b(?:na|mat|nahi|nahin)\\b|(?:\\sन\\s|\\sना\\s|\\sमत\\s|नहीं)",
  "after": "^[^.!?।\\n]{0,25}?(?:\\b(?:mat|na|nahi|nahin)\\b|(?<!\\S)(?:न|ना|मत)(?!\\S)|नहीं)"
 },
 "groups": [
  {
   "id": "urgency",
   "title": "Creates time pressure",
   "weight": 0.25,
   "max_weight": 0.4,
   "category": null,
   "explain": "Scammers rush you so that you act before you think or check.",
   "negatable": false,
   "patterns": {
    "en": [
     "\\burgent(?:ly)?\\b",
     "\\bimmediate(?:ly)?\\b",
     "\\bas soon as possible\\b|\\basap\\b",
     "\\bwithin\\s+(?:the\\s+)?(?:next\\s+)?\\d{1,3}\\s*(?:hours?|hrs?|minutes?|mins?|days?)\\b",
     "\\b(?:today|tonight)\\s+(?:only|itself|at\\s+\\d{1,2}(?:[.:]\\d{2})?\\s*(?:am|pm)?)",
     "\\bby\\s+(?:today|tonight|tomorrow|midnight|end\\s+of\\s+(?:the\\s+)?day)\\b",
     "\\b(?:expires?|expiring|expired)\\s+(?:today|tonight|soon|in\\s+\\d)",
     "\\b(?:last|final)\\s+(?:chance|warning|notice|reminder|call|day|date)\\b",
     "\\bact\\s+(?:now|fast|quickly|immediately)\\b",
     "\\bhurry\\b|\\bdon'?t\\s+delay\\b|\\bdo\\s+not\\s+delay\\b|\\bwithout\\s+(?:any\\s+)?delay\\b|\\bright\\s+(?:away|now)\\b",
     "\\blimited\\s+(?:time|period|offer|seats|slots)\\b",
     "\\bbefore\\s+it'?s?\\s+too\\s+late\\b",
     "\\bvalid\\s+(?:for\\s+)?(?:only\\s+)?\\d{1,3}\\s*(?:hours?|hrs?|minutes?|mins?)\\b",
     "\\bvalid\\s+(?:only\\s+)?(?:till|until|for)\\s+today\\b"
    ],
    "hinglish": [
     "\\bturant\\b",
     "\\bjaldi\\b",
     "\\bfauran\\b",
     "\\babhi\\s+(?:ke\\s+abhi|hi|karo|karein|kare|call)\\b",
     "\\baaj\\s+(?:hi|raat|tak)\\b",
     "\\b\\d{1,2}\\s*(?:ghante|ghanto)\\b",
     "\\bantim\\s+(?:chetavani|suchna|mauka)\\b"
    ],
    "hi": [
     "तुरंत",
     "तुरन्त",
     "फौरन",
     "शीघ्र",
     "जल्द से जल्द",
     "आज ही",
     "आज रात",
     "\\d{1,2}\\s*घंटे",
     "अंतिम (?:चेतावनी|सूचना|मौका)",
     "अभी (?:करें|अपडेट|क्लिक|कॉल)"
    ]
   }
  },
  {
   "id": "threat",
   "title": "Threatens a loss or punishment",
   "weight": 0.35,
   "max_weight": 0.5,
   "category": null,
   "explain": "Fear of losing an account, money or freedom is used to stop you from checking the facts.",
   "negatable": false,
   "patterns": {
    "en": [
     "\\b(?:account|a/c|card|sim|number|service|wallet|upi|net\\s?banking|connection|id|access|profile|policy)\\b[^.!?\\n]{0,40}\\b(?:blocked|suspended|deactivated|frozen|closed|restricted|locked|disabled|terminated|disconnected|cancelled|canceled|deleted|on\\s+hold|limited)\\b",
     "\\b(?:will|shall|would|to)\\s+be\\s+(?:blocked|suspended|deactivated|frozen|closed|restricted|locked|disabled|terminated|disconnected|cancelled|canceled|deleted)\\b",
     "\\b(?:has|have)\\s+been\\s+(?:blocked|suspended|deactivated|frozen|restricted|locked|disabled|compromised|hacked)\\b",
     "\\b(?:unauthori[sz]ed|suspicious|unusual|fraudulent)\\s+(?:activity|login|log-in|sign-in|access|transaction|attempt)s?\\b",
     "\\blegal\\s+action\\b|\\barrest\\s+warrant\\b|\\bwarrant\\b|\\bfir\\b[^.\\n]{0,30}\\b(?:registered|lodged|filed)\\b|\\bcase\\s+(?:has\\s+been\\s+)?(?:registered|filed)\\b|\\bcourt\\s+(?:notice|summons?|case|order)\\b",
     "\\b(?:penalty|fine)\\s+of\\b|\\bpay\\s+(?:a\\s+)?(?:penalty|fine)\\b",
     "\\bif\\s+you\\s+(?:fail|do\\s+not|don'?t)\\b[^.\\n]{0,60}\\b(?:block|suspend|deactivat|clos|terminat|disconnect|legal|penalt|lose|lost)\\w*",
     "\\bsecurity\\s+(?:alert|breach|warning)\\b|\\bis\\s+at\\s+risk\\b"
    ],
    "hinglish": [
     "\\b(?:block|band|bandh|suspend|deactivate)\\s+(?:ho|kar|kiya)\\s*(?:jayega|jaega|jaayega|jayegi|gaya|gya|diya|denge|jaenge)?\\b",
     "\\bkat\\s+(?:jayega|jaega|jayegi|diya\\s+jayega)\\b",
     "\\bkanooni\\s+(?:karwai|karyawahi|karwahi)\\b",
     "\\bgiraftar\\w*\\b",
     "\\bjurmana\\b"
    ],
    "hi": [
     "ब्लॉक",
     "बंद (?:हो|कर)",
     "निलंबित",
     "निष्क्रिय",
     "कानूनी (?:कार्रवाई|कार्यवाही)",
     "गिरफ्तार",
     "जुर्माना",
     "काट दि",
     "कट जाएग"
    ]
   }
  },
  {
   "id": "credential_request",
