    "hinglish": [
     "\\b(?:otp|pin|cvv|password)\\s+(?:batao|bataye|batayen|bataiye|bata\\s+do|bhejo|bheje|bhej\\s+do|share\\s+kar\\w*|daal\\w*|dale|enter\\s+kar\\w*)\\b",
     "\\b(?:apna|apni|aapka|aapki)\\s+(?:otp|pin|cvv|password|card|aadhaar|aadhar|pan)\\b"
    ],
    "hi": [
