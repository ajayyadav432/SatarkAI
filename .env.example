# Copy this file to .env and fill in your key. .env is in .gitignore and is never committed.
# Without a key the assistant still works, using the built-in FAQ and the scan result.
GROQ_API_KEY=
# Optional. Default: qwen/qwen3.8-27b (checked on 14 Oct 2026; replies in Hinglish when asked in Hinglish).
# Other chat models seen on Groq then: openai/gpt-oss-120b, openai/gpt-oss-20b
# GROQ_MODEL=
# Tried in order when the model above is busy (Groq free plan: about 5 questions a minute per model).
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b

# --- Automatic checking ---
# Pairing code the SatarkAI SMS Guard phone app must send. Any short code you choose.
SATARK_TOKEN=
# Inbox watcher: checks every new e-mail automatically. Use a Gmail "app password"
# (Google account > Security > 2-Step Verification > App passwords), not the normal password.
# IMAP_USER=yourtest@gmail.com
# IMAP_PASSWORD=xxxx xxxx xxxx xxxx
# IMAP_HOST=imap.gmail.com
